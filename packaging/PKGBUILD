# Maintainer: Ferropipe contributors <https://github.com/nicatmhmmdv/ferropipe>
#
# Builds the current HEAD of ferropipe. The crate has path dependencies on two
# sibling repositories (ferropipe-rdp and rdpeudp), so all three are cloned as
# siblings under $srcdir and cargo resolves ../ferropipe-rdp and ../rdpeudp.

pkgname=ferropipe-git
pkgver=r15.edbf18f
pkgrel=1
pkgdesc="SSH/SFTP, SMB, WinRM and RDP connection manager with a dual-pane file browser"
arch=('x86_64' 'aarch64')
url="https://github.com/nicatmhmmdv/ferropipe"
license=('MIT')
depends=(libssh2 openssl smbclient)
optdepends=('remmina: RDP sessions'
            'alacritty: default terminal for SSH sessions')
makedepends=(cargo git)
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
source=("ferropipe::git+https://github.com/nicatmhmmdv/ferropipe.git"
        "ferropipe-rdp::git+https://github.com/nicatmhmmdv/ferropipe-rdp.git"
        "rdpeudp::git+https://github.com/nicatmhmmdv/rdpeudp.git")
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

pkgver() {
  cd "$srcdir/ferropipe"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/ferropipe"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/ferropipe"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

check() {
  cd "$srcdir/ferropipe"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --release --frozen
}

package() {
  cd "$srcdir/ferropipe"
  install -Dm755 target/release/ferropipe "$pkgdir/usr/bin/ferropipe"
  install -Dm644 assets/ferropipe.desktop "$pkgdir/usr/share/applications/ferropipe.desktop"
  install -Dm644 assets/ferropipe.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ferropipe.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
